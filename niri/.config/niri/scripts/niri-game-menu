#!/usr/bin/env python3

import json
import shutil
import subprocess
import sys
from pathlib import Path


CONFIG = Path.home() / ".config" / "niri" /  "scripts" / "game-configs.json"
STEAM_LAUNCHER = Path.home() / ".config" / "niri" / "scripts" / "niri-steam-game"


def notify(title: str, body: str) -> None:
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", title, body], check=False)
    else:
        print(f"{title}: {body}", file=sys.stderr)


def load_games() -> list[dict]:
    if not CONFIG.exists():
        notify("niri game launcher", f"Missing config: {CONFIG}")
        raise SystemExit(1)

    with CONFIG.open("r", encoding="utf-8") as f:
        games = json.load(f)

    if not isinstance(games, list):
        notify("niri game launcher", "games.json must contain a JSON array.")
        raise SystemExit(1)

    return games


def choose_with_fuzzel(options: list[str]) -> str:
    proc = subprocess.run(
[
    "fuzzel",
    "--config",
    str(Path.home() / ".config" / "fuzzel" / "game.ini"),
    "--dmenu",
],
        input="\n".join(options) + "\n",
        text=True,
        capture_output=True,
        check=False,
    )

    if proc.returncode != 0:
        raise SystemExit(0)

    return proc.stdout.strip()


def choose_with_rofi(options: list[str]) -> str:
    proc = subprocess.run(
        [
            "rofi",
            "-dmenu",
            "-p",
            "Game",
            "-i",
        ],
        input="\n".join(options) + "\n",
        text=True,
        capture_output=True,
        check=False,
    )

    if proc.returncode != 0:
        raise SystemExit(0)

    return proc.stdout.strip()


def choose(options: list[str]) -> str:
    if shutil.which("fuzzel"):
        return choose_with_fuzzel(options)

    if shutil.which("rofi"):
        return choose_with_rofi(options)

    notify("niri game launcher", "Install fuzzel or rofi.")
    raise SystemExit(1)


def main() -> None:
    games = load_games()

    labels = []
    by_label = {}

    for game in games:
        name = str(game["name"])
        game_id = str(game["game_id"])
        workspace = str(game["workspace"])
        width = int(game["width"])
        height = (width * 9 + 8) // 16

        label = f"{name}  [{workspace}, {width}x{height}, app {game_id}]"
        labels.append(label)
        by_label[label] = game

    selected = choose(labels)

    if not selected:
        raise SystemExit(0)

    game = by_label.get(selected)

    if game is None:
        notify("niri game launcher", "Unknown selection.")
        raise SystemExit(1)

    command = [
        str(STEAM_LAUNCHER),
        str(game["game_id"]),
        str(game["workspace"]),
        str(game["width"]),
    ]

    title = game.get("title")
    if title:
        command.append(str(title))

    subprocess.Popen(command)


if __name__ == "__main__":
    main()
