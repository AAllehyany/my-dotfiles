#!/usr/bin/env python3

import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path


def usage() -> None:
    print(
        "Usage:\n"
        "  niri-steam-game <steam-game-id> <workspace> <width> [window-title]\n\n"
        "Examples:\n"
        "  niri-steam-game 2584990 record 1920 ShadowverseWB\n"
        "  niri-steam-game 1449850 record 2200 'Yu-Gi-Oh! MASTER DUEL'\n",
        file=sys.stderr,
    )
    raise SystemExit(2)


def run(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(args, check=check, text=True)


def niri_action(*args: str, check: bool = True) -> None:
    run("niri", "msg", "action", *args, check=check)


def notify(title: str, body: str) -> None:
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", title, body], check=False)
    else:
        print(f"{title}: {body}")


def get_windows() -> list[dict]:
    result = subprocess.run(
        ["niri", "msg", "--json", "windows"],
        check=True,
        text=True,
        capture_output=True,
    )

    data = json.loads(result.stdout)

    if isinstance(data, list):
        return data

    # Defensive support for possible wrapped JSON shapes.
    if isinstance(data, dict):
        if isinstance(data.get("Windows"), list):
            return data["Windows"]

        ok = data.get("Ok")
        if isinstance(ok, dict) and isinstance(ok.get("Windows"), list):
            return ok["Windows"]

    return []


def find_window_id(game_id: str, title: str | None) -> int | None:
    expected_app_id = f"steam_app_{game_id}"

    for window in get_windows():
        app_id = window.get("app_id") or window.get("app-id")
        window_title = window.get("title")
        window_id = window.get("id")

        if app_id == expected_app_id:
            return int(window_id)

        if title and window_title == title:
            return int(window_id)

    return None


def main() -> None:
    if len(sys.argv) not in (4, 5):
        usage()

    game_id = sys.argv[1]
    workspace = sys.argv[2]
    width_raw = sys.argv[3]
    title = sys.argv[4] if len(sys.argv) == 5 else None

    if not game_id.isdigit():
        print("Game ID must be numeric.", file=sys.stderr)
        raise SystemExit(2)

    if not width_raw.isdigit():
        print("Width must be numeric.", file=sys.stderr)
        raise SystemExit(2)

    width = int(width_raw)
    height = (width * 9 + 8) // 16

    cache_home = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    state_dir = cache_home / "niri-steam-game"
    state_dir.mkdir(parents=True, exist_ok=True)
    (state_dir / f"{game_id}.width").write_text(f"{width}\n")


    niri_action("focus-workspace", workspace)

    subprocess.Popen(
        ["steam", f"steam://rungameid/{game_id}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    tries = int(os.environ.get("NIRI_GAME_TRIES", "120"))
    sleep_time = float(os.environ.get("NIRI_GAME_SLEEP", "0.5"))

    for _ in range(tries):
        window_id = find_window_id(game_id, title)

        if window_id is not None:
            wid = str(window_id)
            print(f"Found window ID: {wid}")

            niri_action("focus-window", "--id", wid)
            niri_action("move-window-to-workspace", workspace)

            niri_action("focus-workspace", workspace)
            time.sleep(0.1)
            niri_action("focus-window", "--id", wid, check=False)

            # Anchor to the beginning/left of the workspace.
            niri_action("move-column-to-first")

            niri_action("set-column-width", str(width))
            niri_action("set-window-height", str(height))
            niri_action("focus-workspace", workspace)
            return

        time.sleep(sleep_time)

    notify("niri game launcher", f"Could not find game window for Steam app {game_id}")
    raise SystemExit(1)


if __name__ == "__main__":
    main()
