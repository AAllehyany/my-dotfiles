#!/usr/bin/env python3
"""Offline fake gh; never contacts GitHub."""
import json
import os
from pathlib import Path
import sys

args = sys.argv[1:]
scenario = os.environ.get("BORON_GH_SCENARIO", "success")
log = os.environ.get("BORON_GH_LOG")
if log:
    with open(log, "a") as stream:
        stream.write(json.dumps(args) + "\n")
if scenario in ("auth", "rate"):
    print("Authentication required" if scenario == "auth" else "API rate limit exceeded", file=sys.stderr)
    sys.exit(1)
if args[:2] == ["auth", "status"]:
    print("Authenticated")
elif args[:2] == ["pr", "view"]:
    print(json.dumps({"number": 12, "title": "Fix launcher", "url": "https://github.com/owner/repo/pull/12", "state": "OPEN", "isDraft": scenario == "draft", "headRefOid": "changed" if scenario == "changed" else "abc123", "baseRefName": "main", "mergeable": "MERGEABLE", "mergeStateStatus": "CLEAN", "reviewDecision": "APPROVED", "statusCheckRollup": [{"conclusion": "SUCCESS"}], "autoMergeRequest": None}))
elif args[:2] == ["pr", "merge"]:
    if scenario == "reject":
        print("Branch protection rejected the merge", file=sys.stderr)
        sys.exit(1)
    print("Merge request submitted")
elif args[0] == "api":
    endpoint = args[3]
    if endpoint.startswith("search/"):
        print(json.dumps({"items": [{"full_name": "owner/repo", "title": "Fix launcher", "number": 12, "state": "open", "repository_url": "https://api.github.com/repos/owner/repo", "html_url": "https://github.com/owner/repo/pull/12", "pull_request": {}}]}))
    elif endpoint == "graphql":
        if scenario == "unknown":
            sys.exit(1)
        print(json.dumps({"data": {"repository": {"pullRequest": {"state": "MERGED" if scenario == "success" else "OPEN", "autoMergeRequest": {"enabledAt": "now"} if scenario == "scheduled" else None, "mergeQueueEntry": {"position": 1} if scenario == "queued" else None}}}}))
    else:
        print(json.dumps({"allow_squash_merge": True, "allow_merge_commit": True, "allow_rebase_merge": False, "permissions": {"push": scenario != "denied"}}))
else:
    sys.exit(2)
